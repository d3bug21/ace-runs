{
  "name": "ace-runs",
  "productName": "Ace Runs!",
  "version": "1.0.0",
  "description": "Ace Runs! - a kid-friendly healthy-food endless runner starring Ace and Moana.",
  "author": "d3bug21",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:web": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:start": "npm run build:web && electron .",
    "audio:manifest": "python3 scripts/build_manifest.py",
    "audio:generate": "node scripts/generate_audio.mjs",
    "package:mac": "npm run build:web && electron-builder --mac --publish never",
    "package:win": "npm run build:web && electron-builder --win --publish never",
    "package:linux": "npm run build:web && electron-builder --linux --publish never",
    "package:all": "npm run build:web && electron-builder --mac --win --linux --publish never"
  },
  "devDependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@types/three": "^0.186.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "homepage": "./",
  "build": {
    "appId": "com.d3bug21.aceruns",
    "productName": "Ace Runs!",
    "executableName": "AceRuns",
    "artifactName": "AceRuns-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**/*", "electron/**/*", "build/icon.png", "package.json"],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64"] }
      ],
      "category": "public.app-category.kids-games",
      "identity": null,
      "icon": "build/icon.png",
      "darkModeSupport": true
    },
    "dmg": { "title": "Ace Runs!" },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.png"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "Ace Runs!" },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "tar.gz", "arch": ["x64"] }
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "synopsis": "A kid-friendly healthy-food endless runner"
    }
  }
}
